<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#0f172a">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📲 Chiếu màn hình lên máy tính"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mở trên máy tính: live/cast.html rồi nhập mã phòng bên dưới"
        android:textSize="13sp"
        android:textColor="#94a3b8"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <EditText
        android:id="@+id/et_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mã phòng (6 ký tự)"
        android:textColor="#ffffff"
        android:textColorHint="#64748b"
        android:inputType="textCapCharacters"
        android:maxLength="6"
        android:gravity="center"
        android:textSize="24sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🖥️ Bắt đầu chiếu màn hình"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏹ Dừng chiếu"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhập mã phòng rồi bấm bắt đầu."
        android:textSize="14sp"
        android:textColor="#cbd5e1"
        android:layout_marginTop="16dp"
        android:gravity="center" />

</LinearLayout>
